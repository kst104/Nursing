# N-Map 로그인 설정 양식
#
# 이 파일을 같은 폴더에 `secrets.toml` 로 복사한 뒤 값을 채우세요.
# secrets.toml 은 .gitignore 에 등록되어 있으므로 절대 커밋되지 않습니다.
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# cookie_secret 생성:
#   python -c "import secrets; print(secrets.token_hex(32))"

[auth]
# 앱의 절대 URL + /oauth2callback  (반드시 이 경로로 끝나야 합니다)
#   로컬:            http://localhost:8501/oauth2callback
#   Streamlit Cloud: https://<your-app>.streamlit.app/oauth2callback
redirect_uri = "http://localhost:8501/oauth2callback"

# 세션 쿠키 서명용 비밀키. 길고 무작위인 값으로, 외부에 노출하지 마세요.
cookie_secret = "여기에_생성한_랜덤값_붙여넣기"


# ---------------------------------------------------------------------------
# 공급자 설정 — 쓸 것만 남기고 나머지는 지우세요.
# 하나만 쓰면 로그인 버튼이 하나, 여러 개면 버튼이 여러 개 나옵니다.
#
# 주의: Streamlit 네이티브 인증은 OIDC 전용입니다.
#       GitHub는 OIDC 디스커버리를 제공하지 않아 이 방식으로는 쓸 수 없습니다.
# ---------------------------------------------------------------------------

# Google — Google Cloud Console > API 및 서비스 > 사용자 인증 정보 >
#          OAuth 클라이언트 ID 만들기 > 웹 애플리케이션
#          '승인된 리디렉션 URI' 에 위 redirect_uri 를 그대로 등록하세요.
[auth.google]
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxxxxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Microsoft Entra ID (구 Azure AD) — Entra 관리센터 > 앱 등록 > 새 등록
#   <TENANT_ID> 를 실제 테넌트 ID로 바꾸세요.
#   조직 계정만 허용하려면 테넌트 ID를, 아무 MS 계정이나 허용하려면 'common' 을 씁니다.
# [auth.microsoft]
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration"

# Okta
# [auth.okta]
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://<your-domain>.okta.com/.well-known/openid-configuration"

# Auth0
# [auth.auth0]
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://<your-tenant>.us.auth0.com/.well-known/openid-configuration"


# ---------------------------------------------------------------------------
# 접근 허용 목록 (선택)
#
# 이 섹션을 아예 두지 않으면 로그인에 성공한 모든 계정이 접근할 수 있습니다.
# 병원 계정만 허용하려면 allowed_domains 를, 특정 인원만 허용하려면
# allowed_emails 를 쓰세요. 둘 다 쓰면 어느 한쪽에만 해당해도 통과합니다.
# ---------------------------------------------------------------------------

# [access]
# allowed_domains = ["yourhospital.or.kr"]
# allowed_emails = ["nurse.kim@gmail.com", "admin@yourhospital.or.kr"]
